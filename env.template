# Sarepta FDA Analysis Framework - Environment Configuration
# Copy this file to .env.local and configure as needed

# OpenAI API Configuration (OPTIONAL)
# The system works with intelligent mock responses when no API key is provided
# Get your API key from: https://platform.openai.com/api-keys
# 
# OpenAI API Configuration (REQUIRED for real AI responses)
# Get your API key from: https://platform.openai.com/api-keys
# 
# IMPORTANT: Use OPENAI_API_KEY (not NEXT_PUBLIC_OPENAI_API_KEY) for security
OPENAI_API_KEY=your_openai_api_key_here

# Development Configuration
NODE_ENV=development

# Optional: Analytics and monitoring
# VERCEL_ANALYTICS_ID=your_analytics_id
# SENTRY_DSN=your_sentry_dsn

# Instructions:
# 1. Copy this file: cp env.template .env.local
# 2. Add your OpenAI API key above (use OPENAI_API_KEY, not NEXT_PUBLIC_OPENAI_API_KEY)
# 3. Restart the development server (npm run dev)
#
# Note: 
# - OPENAI_API_KEY is now secure and server-side only
# - API calls go through your secure endpoint at /api/chat
# - For production, set OPENAI_API_KEY as environment variable on your hosting platform 